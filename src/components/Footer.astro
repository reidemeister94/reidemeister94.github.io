---
const repo = "https://github.com/reidemeister94/reidemeister94.github.io";
---

<footer>
  <p>
    Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
    &amp; Geist, deployed on GitHub Pages. ·
    <a href={repo} target="_blank" rel="noopener">Source</a>
  </p>
</footer>

<style>
  footer {
    padding-block: 3rem 4rem;
  }
  p {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--faint);
    line-height: 1.7;
  }
  a {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--accent-text);
  }
</style>
