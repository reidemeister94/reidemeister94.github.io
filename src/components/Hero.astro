---
import { profile } from "../data/content";
---

<header id="top" class="hero">
  <div class="container">
    <h1>{profile.name}</h1>
    <p class="role">{profile.role} · {profile.location}</p>
    <p class="bio">{profile.bio}</p>
    <p class="links">
      <a href={profile.resumeUrl} target="_blank" rel="noopener">CV</a>
      {
        profile.social.map((s) => (
          <a href={s.url} target="_blank" rel="noopener">
            {s.label}
          </a>
        ))
      }
    </p>
  </div>
</header>

<style>
  .hero {
    padding-block: 4.5rem 1.5rem;
  }
  h1 {
    font-size: 1.85rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
    margin-top: 0.6rem;
  }
  .bio {
    color: var(--muted);
    max-width: 34rem;
    margin-top: 1.5rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
    font-size: 0.92rem;
  }
  .links a {
    color: var(--link);
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .links a:hover {
    border-color: var(--text);
  }
</style>
