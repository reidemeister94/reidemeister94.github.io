---
import { experience } from "../data/content";
---

<section id="experience" class="section">
  <h2 class="section-label">Experience</h2>
  <ol class="entries">
    {
      experience.map((job) => (
        <li class="entry reveal">
          <span class="period mono">{job.period}</span>
          <div class="body">
            <h3>
              {job.role} <span class="co">· {job.company}</span>
            </h3>
            <p class="loc mono">{job.location}</p>
            <ul class="points">
              {job.highlights.map((h) => <li>{h}</li>)}
            </ul>
            {job.tech && (
              <ul class="tech">
                {job.tech.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .entries {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .entry {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    border-radius: 10px;
    border: 1px solid transparent;
    transition:
      background 0.18s ease,
      border-color 0.18s ease;
  }
  .period {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    padding-top: 0.3rem;
  }
  h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
    letter-spacing: -0.01em;
  }
  .co {
    color: var(--accent-text);
  }
  .loc {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin-top: 0.2rem;
  }
  .points {
    list-style: none;
    margin-top: 0.75rem;
    display: grid;
    gap: 0.45rem;
  }
  .points li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .points li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-text);
    font-size: 0.8rem;
  }
  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent-text);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    letter-spacing: 0.01em;
  }
  @media (min-width: 768px) {
    .entry {
      padding: 1.25rem;
      margin: 0 -1.25rem;
    }
    .entry:hover {
      background: var(--card-hover);
      border-color: var(--border);
    }
  }
  @media (max-width: 600px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
