---
import { publications, education } from "../data/content";
---

<section id="writing" class="section">
  <h2 class="section-label">Writing</h2>
  <ul class="list">
    {
      publications.map((pub) => {
        const Tag = pub.url ? "a" : "div";
        return (
          <li class="item reveal">
            <Tag
              {...(pub.url
                ? { href: pub.url, target: "_blank", rel: "noopener" }
                : {})}
              class:list={["row", { linked: !!pub.url }]}
            >
              <span class="meta mono">
                {pub.venue} · {pub.year}
              </span>
              <h3>{pub.title}</h3>
              <p class="desc">{pub.description}</p>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>

<section id="education" class="section">
  <h2 class="section-label">Education</h2>
  <ul class="list">
    {
      education.map((e) => (
        <li class="item">
          <span class="meta mono">{e.period}</span>
          <h3>{e.degree}</h3>
          <p class="desc">
            {e.institution}
            {e.detail ? ` — ${e.detail}` : ""}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .list {
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }
  .meta {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  h3 {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1.4;
    margin-top: 0.3rem;
    letter-spacing: -0.01em;
  }
  .desc {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .row.linked {
    display: block;
    transition: color 0.15s ease;
  }
  .row.linked:hover h3 {
    color: var(--accent-text);
  }
</style>
