---
import { profile } from "../data/content";
---

<section id="contact" class="section">
  <h2 class="section-label">Contact</h2>
  <div class="reveal">
    <p class="lead">
      I'm always happy to talk shop, swap ideas, or hear about an interesting
      problem. The fastest way to reach me is email.
    </p>
    <p class="email-row">
      <a href={`mailto:${profile.email}`} class="email">{profile.email}</a>
      <button id="copy-email" class="copy mono" data-email={profile.email} type="button">
        <span class="label">copy</span>
      </button>
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.getElementById("copy-email");
    if (!btn) return;
    const label = btn.querySelector(".label");
    btn.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") || "";
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = "copied";
        setTimeout(() => {
          if (label) label.textContent = "copy";
        }, 1500);
      } catch {
        window.location.href = "mailto:" + email;
      }
    });
  })();
</script>

<style>
  .lead {
    color: var(--muted);
    max-width: 30rem;
  }
  .email-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .email {
    font-size: 1.1rem;
    color: var(--text-strong);
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .email:hover {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }
  .copy {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .copy:hover {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }
</style>
