---
import { profile } from "../data/content";
import SectionHeading from "./SectionHeading.astro";
import SocialIcon from "./SocialIcon.astro";
---

<section id="contact">
  <div class="container">
    <SectionHeading index="05" title="Contact" />
    <div class="inner reveal">
      <h3>Let's build something.</h3>
      <p class="lead">
        Open to interesting problems in distributed systems, data and ML.
        The fastest way to reach me:
      </p>

      <div class="email-row">
        <a href={`mailto:${profile.email}`} class="email mono">{profile.email}</a>
        <button id="copy-email" class="copy mono" data-email={profile.email} type="button">
          <span class="label">Copy</span>
        </button>
      </div>

      <ul class="socials">
        {
          profile.social.map((s) => (
            <li>
              <a href={s.url} aria-label={s.label} title={s.label} target="_blank" rel="noopener">
                <SocialIcon name={s.name} />
                <span>{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.getElementById("copy-email");
    if (!btn) return;
    const label = btn.querySelector(".label");
    btn.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") || "";
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = "Copied ✓";
        btn.classList.add("done");
        setTimeout(() => {
          if (label) label.textContent = "Copy";
          btn.classList.remove("done");
        }, 1600);
      } catch {
        window.location.href = "mailto:" + email;
      }
    });
  })();
</script>

<style>
  .inner {
    max-width: 40rem;
  }
  h3 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .lead {
    color: var(--text-muted);
    margin-top: 1rem;
    font-size: 1.05rem;
  }
  .email-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .email {
    font-size: 1.05rem;
    color: var(--text);
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 2px;
    transition: color 0.15s ease;
  }
  .email:hover {
    color: var(--accent);
  }
  .copy {
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .copy.done {
    color: var(--accent);
    border-color: var(--accent);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    margin-top: 2.5rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .socials a:hover {
    color: var(--accent);
  }
</style>
