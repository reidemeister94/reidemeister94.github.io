---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#publications", label: "Writing" },
  { href: "#contact", label: "Contact" },
];
---

<header>
  <nav class="container">
    <a href="#top" class="brand mono">silvio<span>.pavanetto</span></a>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="actions">
      <a href="/cv.pdf" class="cv-link mono" target="_blank" rel="noopener">CV</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }
  .brand {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .brand span {
    color: var(--text-faint);
  }
  ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    font-size: 0.9rem;
  }
  ul a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }
  ul a:hover {
    color: var(--text);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cv-link {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .cv-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 680px) {
    ul {
      display: none;
    }
  }
</style>
