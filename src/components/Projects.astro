---
import { projects } from "../data/content";
---

<section id="projects" class="section">
  <h2 class="section-label">Projects</h2>
  <ul class="works">
    {
      projects.map((p) => {
        const tags = [p.language, ...p.tags].filter(Boolean);
        return (
          <li class="work reveal">
            <a class="card" href={p.url} target="_blank" rel="noopener">
              <h3>
                {p.name}
                <span class="arrow" aria-hidden="true">↗</span>
              </h3>
              <p class="desc">{p.description}</p>
              {p.note && <p class="note mono">{p.note}</p>}
              <ul class="tech">
                {tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .works {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .card {
    display: block;
    border-radius: 10px;
    border: 1px solid transparent;
    transition:
      background 0.18s ease,
      border-color 0.18s ease;
  }
  h3 {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }
  .arrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--faint);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }
  .card:hover h3 {
    color: var(--accent-text);
  }
  .card:hover .arrow {
    color: var(--accent-text);
    transform: translate(3px, -3px);
  }
  .desc {
    color: var(--muted);
    font-size: 0.92rem;
    margin-top: 0.4rem;
  }
  .note {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
    margin-top: 0.6rem;
  }
  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent-text);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  @media (min-width: 768px) {
    .card {
      padding: 1.25rem;
      margin: 0 -1.25rem;
    }
    .card:hover {
      background: var(--card-hover);
      border-color: var(--border);
    }
  }
</style>
