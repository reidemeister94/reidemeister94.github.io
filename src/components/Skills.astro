---
import { skills } from "../data/content";
---

<section id="skills" class="section">
  <h2 class="section-label">Skills</h2>
  <dl class="skills">
    {
      skills.map((group) => (
        <div class="group reveal">
          <dt class="meta mono">{group.category}</dt>
          <dd class="items">{group.items.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .skills {
    display: grid;
    gap: 1.25rem;
  }
  .group {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }
  .meta {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .items {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  @media (max-width: 600px) {
    .group {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
