---
interface Props {
  index: string;
  title: string;
}
const { index, title } = Astro.props;
---

<div class="heading reveal">
  <span class="index mono">{index}</span>
  <h2>{title}</h2>
  <span class="rule" aria-hidden="true"></span>
</div>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
  }
  .index {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 500;
  }
  h2 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .rule {
    height: 1px;
    flex: 1;
    background: linear-gradient(
      to right,
      var(--border-strong),
      transparent
    );
  }
</style>
